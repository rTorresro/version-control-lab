   "source": [
    "x = 1\n",
    "\n",
    "name = input(\"Enter a name: \")\n",
    "str(name)\n",
    "\n",
    "while x == 1:\n",
    "    try:\n",
    "        number = input(\"Enter an integer: \")\n",
    "        number = int(number)\n",
    "        x = 0\n",
    "    except ValueError:\n",
    "        x = 1\n",
    "\n",
    "number = number * 5\n",
    "\n",
    "print(\"Name: \" + name)\n",
    "print(\"Number: \" + str(number))"
   ]
